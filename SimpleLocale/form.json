{
    "elements": [
        {
            "type": "SelectCategory",
            "name": "RootCategoryID",
            "caption": "Root-Kategorie (Gäste-Sichtbereich)"
        },
        {
            "type": "Select",
            "name": "SourceLanguage",
            "caption": "Basissprache",
            "options": [
                { "caption": "Deutsch", "value": "de" }
            ]
        },
        {
            "type": "List",
            "name": "TargetLanguages",
            "caption": "Zielsprachen",
            "add": false,
            "delete": false,
            "rowCount": 10,
            "columns": [
                { "caption": "Sprache", "name": "name", "width": "250px" },
                { "caption": "Code", "name": "code", "width": "80px" },
                { "caption": "Aktiv", "name": "enabled", "width": "80px", "add": false, "edit": { "type": "CheckBox" } }
            ]
        },
        {
            "type": "PasswordTextBox",
            "name": "GoogleTranslateAPIKey",
            "caption": "Google Cloud Translate API-Key"
        },
        {
            "type": "NumberSpinner",
            "name": "AutoRescanInterval",
            "caption": "Automatischer Rescan (Minuten, 0 = aus)",
            "minimum": 0
        },
        {
            "type": "List",
            "name": "ObjectNames",
            "caption": "Objektnamen",
            "add": false,
            "delete": true,
            "rowCount": 10,
            "columns": [
                { "caption": "Objekt-ID", "name": "ObjectID", "width": "80px" },
                { "caption": "Pfad", "name": "Path", "width": "200px" },
                { "caption": "Original-Import", "name": "ORIGINAL_IMPORT", "width": "200px" }
            ]
        },
        {
            "type": "List",
            "name": "ObjectTexts",
            "caption": "Eigene Texte",
            "add": false,
            "delete": true,
            "rowCount": 10,
            "columns": [
                { "caption": "Objekt-ID", "name": "ObjectID", "width": "80px" },
                { "caption": "Pfad", "name": "Path", "width": "200px" },
                { "caption": "Original-Import", "name": "ORIGINAL_IMPORT", "width": "200px" }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Sprachliste von Google aktualisieren",
            "onClick": "IPS_RequestAction($id, 'RefreshLanguageList', true);"
        },
        {
            "type": "Button",
            "caption": "Baum jetzt neu einlesen",
            "onClick": "IPS_RequestAction($id, 'Rescan', true);"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Root-Kategorie nicht gesetzt"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Google Translate Fehler - bitte API-Key prüfen"
        }
    ]
}
