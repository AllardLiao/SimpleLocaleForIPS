{
    "elements": [
        {
            "type": "Label",
            "name": "TrialInfoLabel",
            "caption": "Testversion",
            "visible": false
        },
        {
            "type": "PasswordTextBox",
            "name": "LicenseKey",
            "caption": "Lizenzschlüssel"
        },
        {
            "type": "SelectCategory",
            "name": "RootCategoryID",
            "caption": "Root-Kategorie der Visualisierung"
        },
        {
            "type": "Label",
            "name": "UnnamedObjectsLabel",
            "caption": "Folgende Objekte im Root-Baum haben keinen Namen. Bitte zuerst benennen, dann erneut \"Baum neu einlesen\" klicken - erst wenn alle Objekte einen Namen haben, werden Übersetzungen erzeugt.",
            "visible": false
        },
        {
            "type": "List",
            "name": "UnnamedObjects",
            "caption": "Unbenannte Objekte",
            "add": false,
            "delete": false,
            "rowCount": 5,
            "visible": false,
            "columns": [
                { "caption": "Objekt-ID", "name": "ObjectID", "width": "100px" },
                { "caption": "Pfad", "name": "Path", "width": "300px" }
            ],
            "values": []
        },
        {
            "type": "Select",
            "name": "SourceLanguage",
            "caption": "Basissprache",
            "options": [
                { "caption": "Deutsch", "value": "de" }
            ]
        },
        {
            "type": "PasswordTextBox",
            "name": "GoogleTranslateAPIKey",
            "caption": "Google Cloud Translate API-Key"
        },
                {
            "type": "NumberSpinner",
            "name": "AutoRescanInterval",
            "caption": "Automatischer Rescan (Minuten, 0 = aus)",
            "minimum": 0
        },
        {
            "type": "List",
            "name": "TargetLanguages",
            "caption": "Zielsprachen",
            "add": true,
            "delete": true,
            "rowCount": 5,
            "onAdd": "if ($TargetLanguages['code'] == '') { IPS_RequestAction($id, 'ShowApiKeyWarning', true); }",
            "columns": [
                {
                    "caption": "Sprache",
                    "name": "code",
                    "width": "300px",
                    "add": "",
                    "edit": {
                        "type": "Select",
                        "options": [
                            { "caption": "English", "value": "en" }
                        ]
                    }
                }
            ],
            "values": []
        },
        {
            "type": "Select",
            "name": "CurrentLanguage",
            "caption": "Aktuell aktive Sprache",
            "options": [
                { "caption": "Deutsch", "value": "de" }
            ]
        },
        {
            "type": "CheckBox",
            "name": "ShowGlobeIcon",
            "caption": "Weltkugel-Symbol in der Kachel anzeigen"
        },
        {
            "type": "CheckBox",
            "name": "ShowInfoIcon",
            "caption": "Info-Symbol in der Kachel anzeigen"
        },
        {
            "type": "List",
            "name": "ObjectNames",
            "caption": "Objektnamen",
            "add": false,
            "delete": true,
            "rowCount": 10,
            "columns": [
                { "caption": "Objekt-ID", "name": "ObjectID", "width": "80px", "save": true },
                { "caption": "Pfad", "name": "Path", "width": "200px", "save": true },
                { "caption": "Original-Import", "name": "ORIGINAL_IMPORT", "width": "200px", "save": true }
            ]
        },
        {
            "type": "List",
            "name": "ObjectTexts",
            "caption": "Eigene Texte",
            "add": false,
            "delete": true,
            "rowCount": 10,
            "columns": [
                { "caption": "Objekt-ID", "name": "ObjectID", "width": "80px", "save": true },
                { "caption": "Wert-Objekt-ID", "name": "ValueObjectID", "width": "90px", "save": true },
                { "caption": "Pfad", "name": "Path", "width": "200px", "save": true },
                { "caption": "Original-Import (Name)", "name": "ORIGINAL_IMPORT_Name", "width": "150px", "save": true },
                { "caption": "Original-Import (Text)", "name": "ORIGINAL_IMPORT_Text", "width": "200px", "save": true }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Lizenz aktivieren",
            "onClick": "IPS_RequestAction($id, 'ActivateLicense', true);"
        },
        {
            "type": "Button",
            "caption": "Baum neu einlesen und fehlende Übersetzungen ergänzen",
            "onClick": "IPS_RequestAction($id, 'Rescan', true);"
        },
        {
            "type": "Label",
            "caption": "Durchsucht die Root-Kategorie erneut nach neuen/verschobenen Objekten und übersetzt per Google nur noch leere Zellen in Objektnamen und Eigene Texte. Bereits vorhandene Übersetzungen (auch manuell korrigierte) werden dabei nie überschrieben."
        },
        {
            "type": "PopupAlert",
            "name": "ApiKeyMissingPopup",
            "visible": false,
            "popup": {
                "caption": "API-Key fehlt",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Bitte zuerst einen Google Cloud Translate API-Key eintragen und über \"Übernehmen\" speichern, bevor Zielsprachen hinzugefügt werden."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "ApiKeyInvalidPopup",
            "visible": false,
            "popup": {
                "caption": "Sprachliste nicht verfügbar",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Die Sprachliste konnte nicht von Google geladen werden. Bitte den Google Cloud Translate API-Key prüfen (z.B. Tippfehler, abgelaufen, fehlende Berechtigung)."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "LicenseValidPopup",
            "visible": false,
            "popup": {
                "caption": "Lizenz aktiviert",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Der Lizenzschlüssel ist gültig und wurde übernommen."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "LicenseInvalidPopup",
            "visible": false,
            "popup": {
                "caption": "Lizenz ungültig",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Der eingegebene Lizenzschlüssel ist ungültig, manipuliert oder abgelaufen. Bitte prüfen und erneut versuchen."
                    }
                ]
            }
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Root-Kategorie nicht gesetzt"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Unbenannte Objekte im Root-Baum gefunden - siehe Liste im Formular"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Google Translate Fehler - bitte API-Key prüfen"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Testversion abgelaufen - bitte Lizenzschlüssel eintragen und aktivieren"
        }
    ]
}
