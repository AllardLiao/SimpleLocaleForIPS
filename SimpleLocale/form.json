{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "ConfigPanel",
            "caption": "Konfiguration",
            "expanded": true,
            "items": [
                {
                    "type": "SelectInstance",
                    "name": "WebFrontVisuInstanceID",
                    "caption": "Kachel-Visualisierung"
                },
                {
                    "type": "Label",
                    "caption": "Wähle hier deine Kachel-Visualisierungs-Instanz: ihre eigene Startkategorie wird automatisch als Root der Visualisierung übernommen - Namen und Texte innerhalb dieser Kategorie werden übersetzt (siehe Abschnitt \"Übersetzung\" unten). Zusätzlich werden dort frei vergebene Automation-Namen (z.B. \"Gehen\", \"Kommen\") übersetzt und Favoriten erfasst, deren Objekte außerhalb dieser Kategorie liegen. Ohne ausgewählte Instanz bleibt die Übersetzung inaktiv."
                },
                {
                    "type": "Select",
                    "name": "SourceLanguage",
                    "caption": "Basissprache",
                    "options": [
                        {
                            "caption": "Deutsch",
                            "value": "de"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "CurrentLanguage",
                    "caption": "Aktuell aktive Sprache",
                    "options": [
                        {
                            "caption": "Deutsch",
                            "value": "de"
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "ShowGlobeIcon",
                    "caption": "Weltkugel-Symbol in der Kachel anzeigen"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowInfoIcon",
                    "caption": "Info-Symbol in der Kachel anzeigen"
                },
                {
                    "type": "CheckBox",
                    "name": "UseCustomTile",
                    "caption": "Eigene Sprachauswahl-Kachel verwenden"
                },
                {
                    "type": "Label",
                    "caption": "Aktiviert: die eingebaute Dropdown-Kachel wird unterdrückt - baue stattdessen eine eigene Kachel (z.B. HTMLBox), die IPSSL_GetAvailableLanguages() zum Anzeigen und IPSSL_SetLanguage() zum Wechseln der Sprache nutzt. Siehe Dokumentation Abschnitt 7."
                },
                {
                    "type": "ExpansionPanel",
                    "name": "TranslationProviderPanel",
                    "caption": "Übersetzungsanbieter",
                    "expanded": false,
                    "items": [
                        {
                            "type": "Label",
                            "caption": "Ohne jede Eingabe unten funktioniert die Übersetzung sofort über den kostenfreien Anbieter (kein Konto nötig). Google und/oder DeepL sind optional - sind beide eingetragen, wird zuerst der bevorzugte versucht; schlägt ein Anbieter fehl (z.B. Tageskontingent erschöpft), springt die Übersetzung automatisch zum nächsten."
                        },
                        {
                            "type": "PasswordTextBox",
                            "name": "GoogleTranslateAPIKey",
                            "caption": "Google Cloud Translate API-Key (optional)"
                        },
                        {
                            "type": "PasswordTextBox",
                            "name": "DeepLAPIKey",
                            "caption": "DeepL API-Key (optional)"
                        },
                        {
                            "type": "Select",
                            "name": "PreferredPaidProvider",
                            "caption": "Bevorzugter Anbieter (nur relevant, wenn beide oben eingetragen sind)",
                            "options": [
                                {
                                    "caption": "Google zuerst",
                                    "value": "google"
                                },
                                {
                                    "caption": "DeepL zuerst",
                                    "value": "deepl"
                                }
                            ]
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "FreeTranslateContactEmail",
                            "caption": "Kontakt-E-Mail für den kostenfreien Anbieter (optional, hebt das Tageskontingent von 5.000 auf 50.000 Zeichen)"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "AutoRescanInterval",
                    "caption": "Automatischer Rescan (Minuten, 0 = aus)",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "TranslationPanel",
            "caption": "Übersetzung",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "TargetLanguages",
                    "caption": "Zielsprachen",
                    "add": true,
                    "delete": true,
                    "rowCount": 5,
                    "onAdd": "if ($TargetLanguages['code'] == '') { IPS_RequestAction($id, 'ShowApiKeyWarning', true); }",
                    "columns": [
                        {
                            "caption": "Sprache",
                            "name": "code",
                            "width": "300px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "English",
                                        "value": "en"
                                    }
                                ]
                            }
                        }
                    ],
                    "values": []
                },
                {
                    "type": "Label",
                    "name": "UnnamedObjectsLabel",
                    "caption": "Folgende Objekte im Root-Baum haben keinen Namen. Bitte zuerst benennen, dann erneut \"Baum neu einlesen\" klicken - erst wenn alle Objekte einen Namen haben, werden Übersetzungen erzeugt.",
                    "visible": false
                },
                {
                    "type": "List",
                    "name": "UnnamedObjects",
                    "caption": "Unbenannte Objekte",
                    "add": false,
                    "delete": false,
                    "rowCount": 5,
                    "visible": false,
                    "columns": [
                        {
                            "caption": "Objekt-ID",
                            "name": "ObjectID",
                            "width": "100px"
                        },
                        {
                            "caption": "Pfad",
                            "name": "Path",
                            "width": "300px"
                        }
                    ],
                    "values": []
                },
                {
                    "type": "List",
                    "name": "ObjectNames",
                    "caption": "Objektnamen",
                    "add": false,
                    "delete": true,
                    "rowCount": 10,
                    "columns": [
                        {
                            "caption": "Objekt-ID",
                            "name": "ObjectID",
                            "width": "80px",
                            "save": true
                        },
                        {
                            "caption": "Pfad",
                            "name": "Path",
                            "width": "200px",
                            "save": true
                        },
                        {
                            "caption": "Original-Import",
                            "name": "ORIGINAL_IMPORT",
                            "width": "200px",
                            "save": true
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "ObjectTexts",
                    "caption": "Eigene Texte",
                    "add": false,
                    "delete": true,
                    "rowCount": 10,
                    "columns": [
                        {
                            "caption": "Objekt-ID",
                            "name": "ObjectID",
                            "width": "80px",
                            "save": true
                        },
                        {
                            "caption": "Wert-Objekt-ID",
                            "name": "ValueObjectID",
                            "width": "90px",
                            "save": true
                        },
                        {
                            "caption": "Pfad",
                            "name": "Path",
                            "width": "200px",
                            "save": true
                        },
                        {
                            "caption": "Original-Import (Name)",
                            "name": "ORIGINAL_IMPORT_Name",
                            "width": "150px",
                            "save": true
                        },
                        {
                            "caption": "Original-Import (Text)",
                            "name": "ORIGINAL_IMPORT_Text",
                            "width": "200px",
                            "save": true
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "EnumerationOptions",
                    "caption": "Beschriftungen",
                    "add": false,
                    "delete": true,
                    "rowCount": 10,
                    "columns": [
                        {
                            "caption": "Profil/Template",
                            "name": "SourceKey",
                            "width": "160px",
                            "save": true
                        },
                        {
                            "caption": "Pfad",
                            "name": "Path",
                            "width": "200px",
                            "save": true
                        },
                        {
                            "caption": "Variablen-IDs",
                            "name": "ValueObjectIDs",
                            "width": "120px",
                            "save": true
                        },
                        {
                            "caption": "Feld",
                            "name": "FieldPath",
                            "width": "120px",
                            "save": true
                        },
                        {
                            "caption": "Original-Import",
                            "name": "ORIGINAL_IMPORT",
                            "width": "200px",
                            "save": true
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "ObjectAutomations",
                    "caption": "Automations",
                    "add": false,
                    "delete": true,
                    "rowCount": 10,
                    "columns": [
                        {
                            "caption": "AutomationID",
                            "name": "AutomationID",
                            "width": "100px",
                            "save": true
                        },
                        {
                            "caption": "Original-Import",
                            "name": "ORIGINAL_IMPORT",
                            "width": "250px",
                            "save": true
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "ObjectGreeting",
                    "caption": "Begrüßung",
                    "add": false,
                    "delete": true,
                    "rowCount": 2,
                    "columns": [
                        {
                            "caption": "Original-Import",
                            "name": "ORIGINAL_IMPORT",
                            "width": "250px",
                            "save": true
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "LicensePanel",
            "caption": "Lizenz",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "TrialInfoLabel",
                    "caption": "Testversion",
                    "visible": false
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "PasswordTextBox",
                            "name": "LicenseKey",
                            "caption": "Lizenzschlüssel",
                            "width": "400px"
                        },
                        {
                            "type": "Label",
                            "name": "LicenseInfoLabel",
                            "caption": "",
                            "visible": false
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Lizenz aktivieren",
            "onClick": "IPS_RequestAction($id, 'ActivateLicense', true);"
        },
        {
            "type": "Button",
            "caption": "Visualisierung neu einlesen und fehlende Übersetzungen ergänzen",
            "onClick": "IPS_RequestAction($id, 'Rescan', true);"
        },
        {
            "type": "Label",
            "caption": "Durchsucht den Root der Visualisierung erneut nach neuen/verschobenen Objekten und übersetzt nur noch leere Zellen in Objektnamen, Eigene Texte und Beschriftungen. Bereits vorhandene Übersetzungen (auch manuell korrigierte) werden dabei nie überschrieben."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Produktinformationen",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Image",
                            "image": "data:image/png;base64,",
                            "onClick": "echo 'https://www.synergetix.de/simplelocale/pricing.php';"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "\nLizenz",
                    "bold": true
                },
                {
                    "type": "Label",
                    "caption": "Simple Locale for IP-Symcon ist proprietäre, kommerzielle Software von Synergetix mit kostenloser Testversion (siehe Abschnitt \"Lizenz\" oben) - kein Open-Source-Projekt."
                },
                {
                    "type": "Label",
                    "caption": "Das Entfernen oder Umgehen der Lizenzprüfung ist auch mit KI-Unterstützung nicht gestattet und verstößt gegen Urheberrecht und Lizenzbedingungen (siehe LICENSE im Repository)."
                },
                {
                    "type": "Label",
                    "caption": "Produktseite: https://www.synergetix.de/simplelocale/"
                },
                {
                    "type": "Label",
                    "caption": "Lizenz erwerben: https://www.synergetix.de/simplelocale/pricing.php"
                }
            ]
        },
        {
            "name": "ApiKeyMissingPopup",
            "type": "PopupAlert",
            "visible": false,
            "popup": {
                "caption": "API-Key fehlt",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Bitte zuerst einen Google Cloud Translate API-Key eintragen und über \"Übernehmen\" speichern, bevor Zielsprachen hinzugefügt werden."
                    }
                ]
            }
        },
        {
            "name": "ApiKeyInvalidPopup",
            "type": "PopupAlert",
            "visible": false,
            "popup": {
                "caption": "Sprachliste nicht verfügbar",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Die Sprachliste konnte nicht von Google geladen werden. Bitte den Google Cloud Translate API-Key prüfen (z.B. Tippfehler, abgelaufen, fehlende Berechtigung)."
                    }
                ]
            }
        },
        {
            "name": "LicenseValidPopup",
            "type": "PopupAlert",
            "visible": false,
            "popup": {
                "caption": "Lizenz aktiviert",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Der Lizenzschlüssel ist gültig und wurde übernommen."
                    }
                ]
            }
        },
        {
            "name": "LicenseInvalidPopup",
            "type": "PopupAlert",
            "visible": false,
            "popup": {
                "caption": "Lizenz ungültig",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "caption": "Der eingegebene Lizenzschlüssel ist ungültig, manipuliert oder abgelaufen. Bitte prüfen und erneut versuchen."
                    }
                ]
            }
        },
        {
            "name": "LicenseBlockedPopup",
            "type": "PopupAlert",
            "visible": false,
            "popup": {
                "caption": "Dieser Lizenzschlüssel wurde bereits upgegradet",
                "closeCaption": "OK",
                "items": [
                    {
                        "type": "Label",
                        "name": "LicenseBlockedPopupText",
                        "caption": "Dieser Lizenzschlüssel wurde bereits gegen eine höherwertige Edition eingetauscht und ist daher nicht mehr gültig. Damit du in Ruhe einen gültigen Schlüssel eintragen kannst, läuft ab jetzt eine neue, volle 30-Tage-Testphase mit allen Pro-Funktionen."
                    }
                ]
            }
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Root der Visualisierung nicht gesetzt"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Unbenannte Objekte im Root-Baum gefunden - siehe Liste im Formular"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Google Translate Fehler - bitte API-Key prüfen"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Testversion abgelaufen - bitte Lizenzschlüssel eintragen und aktivieren"
        }
    ]
}
